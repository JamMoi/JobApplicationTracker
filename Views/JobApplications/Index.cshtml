@model IEnumerable<JobApplicationTracker.Models.JobApplication>

@{
    ViewData["Title"] = "Job Applications";
}

<h1>Job Applications</h1>

<table class="table">
    <thead>
        <tr>
            <th>Company</th>
            <th>Job Title</th>
            <th>Date Applied</th>
            <th>Deadline</th>
            <th>Status</th>
            <th>Actions</th>

            
        </tr>
    </thead>
    <tbody>
        @foreach (var application in Model)
        {
            <tr>
                <td>@application.CompanyName</td>
                <td>@application.JobTitle</td>
                <td>@(application.ApplicationDate?.ToString("dd.MM.yyyy") ?? "-")</td>
                <td>@(application.Deadline?.ToString("dd.MM.yyyy") ?? "-")</td>
                <td>@application.Status</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@application.Id" 
                    class="btn btn-primary">Edit</a>
                </td>
                <td>
                    <a asp-action="Delete" asp-route-id="@application.Id"
                    class = "btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }

    </tbody>
</table>
